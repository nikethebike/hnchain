{
  "schema": "hnchain.conformance.core.hncs-primitives",
  "version": "0.1.0",
  "status": "draft",
  "byte_order": "little-endian",
  "scope": {
    "included": [
      "bool",
      "fixed_width_integers",
      "bounded_bytes",
      "bounded_utf8_strings"
    ],
    "excluded": [
      "address",
      "transaction",
      "block",
      "consensus",
      "validator",
      "economics",
      "rpc",
      "p2p",
      "database"
    ]
  },
  "properties": [
    "decode(encode(x)) == x",
    "each valid value has exactly one canonical byte representation",
    "decoders reject malformed primitive encodings",
    "top-level decoders reject trailing bytes"
  ],
  "booleans": {
    "canonical": [
      {
        "name": "false",
        "value": false,
        "hex": "00"
      },
      {
        "name": "true",
        "value": true,
        "hex": "01"
      }
    ],
    "invalid": [
      {
        "name": "invalid-02",
        "hex": "02",
        "error": "invalid_bool"
      },
      {
        "name": "invalid-ff",
        "hex": "ff",
        "error": "invalid_bool"
      }
    ]
  },
